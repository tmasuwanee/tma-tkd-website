  "query": "\n-- Find the 13 day_0 queue items that are \"sent\" but have no matching activity today\n-- (these were sent earlier in the sequence lifecycle, not today)\nSELECT q.id, q.status, q.sentAt, q.leadId\nFROM leadSequenceQueue q\nWHERE q.sequenceKey = 'summer_camp_nurture'\n  AND q.touchKey = 'day_0_camp_overview'\n  AND q.status = 'sent'\n  AND DATE(q.sentAt) != '2026-06-09'\nORDER BY q.sentAt;\n",
